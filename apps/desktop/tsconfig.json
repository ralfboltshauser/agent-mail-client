{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": ".types",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/renderer/src/*"] },
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/composer" },
    { "path": "../cli" }
  ]
}
