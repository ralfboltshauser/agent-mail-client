[Unit]
Description=AMC nightly SQLite backup
Documentation=https://github.com/ralfboltshauser/agent-mail-client
RequiresMountsFor=/srv/amc
ConditionPathExists=/opt/amc/current/amc-engine.mjs

[Service]
Type=oneshot
User=amc
Group=amc
Environment=AMC_CONFIG=/etc/amc/config.json
Environment=NODE_ENV=production
ExecStart=/opt/amc/node/bin/node --disable-warning=ExperimentalWarning --enable-source-maps /opt/amc/current/amc-engine.mjs backup

# ADR 0003: the Engine's data and secrets are its own. Lock everything else down.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
ReadWritePaths=/srv/amc /var/lib/amc
ReadOnlyPaths=/etc/amc /opt/amc
