{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "defaultWorktreeBaseRef": "main",
  "scripts": [
    {
      "name": "Install worktree dependencies",
      "command": "CI=true pnpm install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Desktop dev",
      "command": "pnpm --filter @amc/desktop dev",
      "icon": "play",
      "stopOnSettle": true
    }
  ]
}
