{
  "name": "amc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p test/renderer",
    "lint": "biome check .",
    "lint:renderer": "node scripts/lint-renderer.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:html-reader": "env -u ELECTRON_RUN_AS_NODE pnpm --filter @amc/desktop exec electron ../../test/electron/html-reader.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:renderer && pnpm test",
    "verify": "sh scripts/verify-local.sh",
    "release": "node scripts/release.mjs",
    "deploy:host": "scripts/deploy-host.sh",
    "cli:install": "pnpm --filter @amc/cli build && bash scripts/install-cli.sh",
    "desktop:install": "bash scripts/install-desktop.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
